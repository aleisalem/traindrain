## USE THIS FILE TO STORE ENVIRONMENT VARIABLES YOU NEED DURING LOCAL DEVELOPMENT AND TESTING
## Copy this file to .env and fill in real values. Never commit .env.

# Postgres (used by docker-compose and the backend).
# POSTGRES_PASSWORD is required — docker-compose refuses to start Postgres
# without it, so this file must be copied to .env before `docker-compose up`.
# The value below is a local-dev-only convenience; never reuse it anywhere
# beyond your own machine.
POSTGRES_USER=traindrain
POSTGRES_PASSWORD=traindrain
POSTGRES_DB=traindrain

# LocalStack (SES emulation). SES runs on the free Community edition, so
# LOCALSTACK_AUTH_TOKEN is optional for this release — only needed if you
# later enable a Pro-only service. Get a token from https://app.localstack.cloud
# if/when required.
LOCALSTACK_AUTH_TOKEN=
LOCALSTACK_DEBUG=0

# Envelope-encryption key for TOTP secrets at rest (base64-encoded 32
# random bytes, used with AES-256-GCM). The value below is a local-dev-only
# convenience, like POSTGRES_PASSWORD above — never reuse it anywhere beyond
# your own machine. Generate your own with:
#   python3 -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# In production this is injected from AWS Secrets Manager, not set here.
TWO_FACTOR_ENCRYPTION_KEY=